{
  "builds": [
    {
      "src": "api/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "phase_7_frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "api/main.py"
    },
    {
      "source": "/(.*)",
      "destination": "phase_7_frontend/$1"
    }
  ]
}
